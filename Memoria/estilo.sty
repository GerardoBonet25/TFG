  sensitive=true,
  morestring=[b]",
  morestring=[b]'
}



\lstdefinelanguage{GodotShader}{
  morekeywords={
    shader_type, render_mode, uniform, varying, void, if, else, return,
    sampler2D, sampler3D, samplerCube, vec2, vec3, vec4, mat4,
