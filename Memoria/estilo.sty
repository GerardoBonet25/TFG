    ALBEDO, EMISSION, SPECULAR, NORMAL, ALPHA, ROUGHNESS, METALLIC,
    VERTEX, COLOR, UV, UV2, SCREEN_UV, POINT_SIZE,
    TIME, INSTANCE_ID, POSITION, NORMALMAP,
    FRAGCOORD, MODELVIEW_MATRIX, PROJECTION_MATRIX, WORLD_MATRIX,
  },
  sensitive=true,
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]",
  morestring=[b]',
}


